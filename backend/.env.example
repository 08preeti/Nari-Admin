NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/the-nari
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
# Comma-separated list of allowed browser origins. REQUIRED in production.
CORS_ORIGINS=http://localhost:5173
# Used to bucket dashboard trends by local day/month
BUSINESS_TIMEZONE=Asia/Kolkata
ADMIN_NAME=The Nari Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Optional: used only by `npm test` integration tests (use a THROWAWAY database!)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/the-nari-test
